# Copy to .env next to docker-compose.yml and adjust.

# Public URL of the platform; used to build webhook URLs for GitHub.
SHIPYARD_PUBLIC_URL=http://localhost:8080

# HTTPS. Plain HTTP is the default (no certificates, no port 443 listener).
# Set to true when a real domain points at this server and Caddy can reach Let's Encrypt.
SHIPYARD_HTTPS=false

# Optional: serve the UI through Caddy on this hostname (e.g. shipyard.example.com).
# When empty, Caddy proxies plain HTTP on port 80 to the Shipyard UI for any unmatched host.
SHIPYARD_PLATFORM_DOMAIN=

# Optional: every application is also reachable at <app-slug>.<base domain>.
# Needs a wildcard DNS record (*.apps.example.com -> this server).
SHIPYARD_BASE_DOMAIN=

# Email for Let's Encrypt registration (optional but recommended).
SHIPYARD_ACME_EMAIL=

# First-boot administrator (optional; otherwise the UI asks you to create one).
SHIPYARD_ADMIN_USERNAME=
SHIPYARD_ADMIN_PASSWORD=

# Tuning
SHIPYARD_WORKER_THREADS=2            # applications that may deploy at the same time
SHIPYARD_RETAIN_DEPLOYMENTS=10       # artifacts kept per application for rollback
SHIPYARD_CRASH_RESTART_THRESHOLD=5   # restarts before an application is marked CRASHED

# Host port of Caddy's HTTP listener, if not 80 (detected from the Caddy container when empty).
# Local hostnames such as devstick.local then get it in their URLs: http://devstick.local:8081
SHIPYARD_HTTP_PORT=

# Host directory for all platform data (compose only)
SHIPYARD_HOST_DATA=/var/lib/shipyard
SHIPYARD_UI_PORT=8080
